VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# For now, you can keep auth as a placeholder:
# - mock (default): choose an account from a list
# - supabase: real Google SSO via Supabase Auth
VITE_AUTH_MODE="mock"

# Matches the HTML's `CID = 1`
VITE_CLIENT_ID="1"

# Optional: explicit redirect URL for OAuth (otherwise defaults to window.location.origin)
# VITE_OAUTH_REDIRECT_TO="http://localhost:5173"

